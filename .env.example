# SuperNode 环境变量模板
# 复制为 .env 并填入实际值:  cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到仓库。

# 邮件服务
# console = 开发模式，验证码打印到终端
# smtp = 生产模式，通过 SMTP 发送
SUPERNODE_EMAIL_BACKEND=console

# SMTP 配置（email_backend=smtp 时必填）
SUPERNODE_SMTP_HOST=
SUPERNODE_SMTP_PORT=465
SUPERNODE_SMTP_USER=
SUPERNODE_SMTP_PASSWORD=
SUPERNODE_EMAIL_FROM=
